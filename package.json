{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "tsc -b && vite build",
    "desktop": "npx electron ./electron/main.ts",
    "build:exe": "npm run build && npx electron-builder --win portable",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.moderationstudio.desktop",
    "productName": "Moderation Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.ts",
      "package.json"
    ],
    "win": {
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "ModerationStudio-Portable.exe"
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.51.0",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
